# Copy to .env (docker compose reads it automatically) or export these vars.

# Anthropic API key — without it Artha falls back to the deterministic
# rule-based query understanding, which supports the same core questions.
ANTHROPIC_API_KEY=

# Force a provider instead of auto-detecting: "anthropic" or "rule_based".
# Leave empty for auto (anthropic when a key is set, rule_based otherwise).
ARTHA_LLM_PROVIDER=

# Model used for structured query understanding when provider is anthropic.
ARTHA_LLM_MODEL=claude-haiku-4-5

# Database URL (compose sets this for the backend already).
ARTHA_DATABASE_URL=postgresql+psycopg2://artha:artha@localhost:5432/artha

# Allowed browser origins for CORS (comma-separated). Empty = localhost:5173.
ARTHA_CORS_ORIGINS=
