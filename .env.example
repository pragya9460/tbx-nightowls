# Copy to .env (docker compose reads it automatically) or export these vars.

# MySQL connection string (required). Local default matches docker-compose.
ARTHA_DATABASE_URL=mysql://artha:artha@127.0.0.1:3306/artha

# Force a provider: "ollama" | "anthropic" | "rule_based".
# Leave empty for auto (anthropic when a key is set, rule_based otherwise).
ARTHA_LLM_PROVIDER=

# Model for Anthropic or Ollama (e.g. claude-haiku-4-5 or qwen2.5-coder:7b).
ARTHA_MODEL=qwen2.5-coder:7b

# Ollama base URL when ARTHA_LLM_PROVIDER=ollama
ARTHA_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Anthropic API key — used when provider is anthropic (or auto with a key set).
ANTHROPIC_API_KEY=

# CSV directory used when bootstrapping MySQL.
# ARTHA_DATA_DIR=

# Query result cache (same FinancialQuery → reuse MySQL result).
# ARTHA_REDIS_URL=redis://localhost:6379/0
# Leave unset to use in-process memory cache.
# ARTHA_QUERY_CACHE=1
# ARTHA_QUERY_CACHE_TTL=300

# Allowed browser origins for CORS (comma-separated). Empty = localhost:5173.
ARTHA_CORS_ORIGINS=
